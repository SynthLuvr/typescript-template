{
  "name": "typescript-template",
  "private": true,
  "description": "A TypeScript project template with a complete build, format, lint, and test toolchain",
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": "==26"
  },
  "scripts": {
    "build": "tsc",
    "format": "ts-canon format",
    "lint": "ts-canon lint",
    "test": "vitest run --coverage",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.0.5",
    "ts-canon": "^0.3.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
